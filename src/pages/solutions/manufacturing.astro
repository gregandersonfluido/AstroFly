---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Manufacturing Solutions">
  <div class="solution-hero">
    <div class="container">
      <h1>Manufacturing & Industrial Automation</h1>
      <p class="tagline">Streamline production and quality control with intelligent aerial monitoring</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="solution-overview">
        <div class="overview-content">
          <h2>Transforming Industrial Operations with Aerial Intelligence</h2>
          <p>
            AstroFly Robotics is revolutionizing manufacturing and industrial processes with our autonomous drone solutions. By introducing aerial monitoring and inspection capabilities, we enable manufacturers to gain unprecedented visibility into their operations, identify inefficiencies, detect quality issues, and enhance workplace safety.
          </p>
          <p>
            Our industrial drones are designed to integrate seamlessly with your manufacturing systems, providing valuable data that helps optimize production, reduce downtime, and enhance quality control processes.
          </p>
          <p>
            From routine inspections of large manufacturing facilities to specialized monitoring of production lines, our drones serve as a powerful tool for industrial automation and process improvement.
          </p>
        </div>
        <div class="overview-image">
          <img src="/images/solutions/manufacturing-overview.jpg" alt="Drone monitoring manufacturing facility" onerror="this.src='/images/placeholder.jpg'">
        </div>
      </div>

      <div class="key-capabilities">
        <h2>Key Manufacturing Capabilities</h2>
        <div class="capabilities-grid">
          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12.5A4.5 4.5 0 0 1 6.5 8H20"></path>
                <path d="M20 12.5A4.5 4.5 0 0 1 15.5 17H6.5"></path>
                <line x1="2" y1="20" x2="2" y2="20"></line>
              </svg>
            </div>
            <h3>Automated Quality Control</h3>
            <p>
              Scheduled or on-demand inspections of production output, identifying defects and inconsistencies that might be missed by traditional quality control methods.
            </p>
          </div>

          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
              </svg>
            </div>
            <h3>Production Monitoring</h3>
            <p>
              Real-time monitoring of production lines and manufacturing processes, providing supervisors with immediate insights into workflow and potential bottlenecks.
            </p>
          </div>

          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <h3>Equipment Inspection</h3>
            <p>
              Thermal and visual inspection of manufacturing equipment to detect potential malfunctions, overheating components, or maintenance needs before they cause downtime.
            </p>
          </div>

          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </div>
            <h3>Safety Monitoring</h3>
            <p>
              Continuous observation of work areas to identify safety hazards, regulatory compliance issues, or dangerous conditions before they lead to accidents.
            </p>
          </div>

          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <rect x="7" y="7" width="3" height="9"></rect>
                <rect x="14" y="7" width="3" height="5"></rect>
              </svg>
            </div>
            <h3>Inventory Management</h3>
            <p>
              Automated scanning and counting of inventory in warehouses and storage areas, reducing the time and labor required for manual inventory audits.
            </p>
          </div>

          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <h3>Data Integration</h3>
            <p>
              Seamless integration with manufacturing execution systems (MES), enterprise resource planning (ERP), and business intelligence platforms.
            </p>
          </div>
        </div>
      </div>

      <div class="use-cases">
        <h2>Manufacturing Use Cases</h2>
        
        <div class="use-case">
          <div class="use-case-image">
            <img src="/images/solutions/manufacturing-quality.jpg" alt="Drone performing quality inspection" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="use-case-content">
            <h3>Automated Quality Inspection</h3>
            <p>
              Deploy drones equipped with high-resolution cameras and specialized sensors to perform automated quality checks on production outputs. Our systems can detect defects, inconsistencies, and quality issues that might be missed by human inspectors or fixed camera systems.
            </p>
            <ul class="benefits">
              <li>Consistent, objective quality assessment</li>
              <li>Inspection of large or hard-to-reach products</li>
              <li>Automated documentation of quality issues</li>
              <li>Integration with quality management systems</li>
            </ul>
          </div>
        </div>
        
        <div class="use-case reverse">
          <div class="use-case-image">
            <img src="/images/solutions/manufacturing-thermal.jpg" alt="Drone performing thermal inspection" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="use-case-content">
            <h3>Predictive Maintenance</h3>
            <p>
              Utilize thermal imaging and vibration analysis to identify equipment issues before they lead to failures or downtime. Our drones can scan production equipment to detect overheating components, unusual vibration patterns, or other early warning signs of equipment failure.
            </p>
            <ul class="benefits">
              <li>Reduce unplanned downtime by up to 45%</li>
              <li>Extend equipment lifespan through timely maintenance</li>
              <li>Safe inspection of hazardous or hard-to-reach equipment</li>
              <li>Historical data collection for maintenance planning</li>
            </ul>
          </div>
        </div>
        
        <div class="use-case">
          <div class="use-case-image">
            <img src="/images/solutions/manufacturing-inventory.jpg" alt="Drone scanning warehouse inventory" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="use-case-content">
            <h3>Warehouse & Inventory Management</h3>
            <p>
              Transform inventory management with automated aerial scanning of warehouse contents. Our drones can quickly and accurately count inventory, identify misplaced items, and help optimize storage space utilization.
            </p>
            <ul class="benefits">
              <li>Reduce inventory counting time by up to 85%</li>
              <li>Improve inventory accuracy to over 99%</li>
              <li>Identify storage optimization opportunities</li>
              <li>Monitor inventory movements in real-time</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="integration">
        <h2>Integration with Manufacturing Systems</h2>
        <div class="integration-content">
          <p>
            AstroFly Robotics' manufacturing solutions are designed to integrate with your existing industrial systems and software platforms, creating a seamless flow of information:
          </p>
          
          <div class="integration-grid">
            <div class="integration-card">
              <h3>Manufacturing Execution Systems (MES)</h3>
              <p>Feed drone-collected data directly into your MES for real-time production insights and quality tracking.</p>
            </div>
            
            <div class="integration-card">
              <h3>Enterprise Resource Planning (ERP)</h3>
              <p>Integrate inventory counts and production monitoring data with your ERP system for improved planning and forecasting.</p>
            </div>
            
            <div class="integration-card">
              <h3>Quality Management Systems</h3>
              <p>Automatically log quality inspection data, defect images, and quality metrics into your quality management platform.</p>
            </div>
            
            <div class="integration-card">
              <h3>Computerized Maintenance Management</h3>
              <p>Create automated maintenance tickets based on drone-detected equipment anomalies or potential failures.</p>
            </div>
          </div>
          
          <p class="integration-note">
            Our system architects work with your IT and operations teams to design integration solutions that adhere to your security protocols and data management policies, ensuring a smooth implementation that delivers immediate value.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section product-highlight">
    <div class="container">
      <h2>Featured Manufacturing Products</h2>
      <div class="product-cards">
        <div class="product-card">
          <div class="product-image">
            <img src="/images/products/astroinspect-z2.jpg" alt="AstroInspect Z2 Industrial Inspection Drone" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="product-content">
            <h3>AstroInspect Z2</h3>
            <p>Our specialized industrial inspection drone with ultra-high resolution imaging and thermal analysis capabilities.</p>
            <a href="/products/astroinspect-z2" class="button button-secondary">Learn More</a>
          </div>
        </div>
        
        <div class="product-card">
          <div class="product-image">
            <img src="/images/products/astrocargo-d3.jpg" alt="AstroCargo D3 Delivery Drone" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="product-content">
            <h3>AstroCargo D3</h3>
            <p>Autonomous aerial logistics and intra-facility transportation for streamlined material handling in large manufacturing facilities.</p>
            <a href="/products/astrocargo-d3" class="button button-secondary">Learn More</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to Optimize Your Manufacturing Operations?</h2>
        <p>Contact our industrial solutions team to discuss how AstroFly Robotics can enhance your manufacturing processes with aerial intelligence.</p>
        <div class="cta-buttons">
          <a href="/contact" class="button button-accent">Contact Us</a>
          <a href="/about" class="button button-secondary">Learn About Our Technology</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .solution-hero {
    background: var(--gradient-primary);
    color: white;
    padding: var(--space-xl) 0;
    text-align: center;
  }
  
  .solution-hero h1 {
    color: white;
    font-size: 3rem;
    margin-bottom: var(--space-sm);
  }
  
  .tagline {
    font-size: 1.5rem;
    opacity: 0.9;
    max-width: 800px;
    margin: 0 auto;
  }
  
  /* Solution Overview */
  .solution-overview {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }
  
  .overview-content h2 {
    margin-top: 0;
  }
  
  .overview-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  
  .overview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  /* Capabilities Grid */
  .key-capabilities {
    margin: var(--space-xl) 0;
  }
  
  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }
  
  .capability-card {
    background-color: white;
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal);
  }
  
  .capability-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }
  
  .capability-icon {
    color: var(--color-secondary);
    margin-bottom: var(--space-md);
  }
  
  /* Use Cases */
  .use-cases {
    margin: var(--space-xl) 0;
  }
  
  .use-case {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
    align-items: center;
  }
  
  .use-case.reverse {
    grid-template-columns: 1fr 1fr;
    direction: rtl;
  }
  
  .use-case.reverse .use-case-content {
    direction: ltr;
  }
  
  .use-case-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  
  .use-case-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .use-case-content h3 {
    margin-top: 0;
    color: var(--color-secondary);
  }
  
  .benefits {
    list-style-type: none;
    padding: 0;
    margin-top: var(--space-md);
  }
  
  .benefits li {
    padding-left: var(--space-md);
    position: relative;
    margin-bottom: var(--space-sm);
  }
  
  .benefits li::before {
    content: "✓";
    color: var(--color-success);
    position: absolute;
    left: 0;
    font-weight: bold;
  }
  
  /* Integration */
  .integration {
    margin: var(--space-xl) 0;
    background-color: white;
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-md);
  }
  
  .integration h2 {
    margin-top: 0;
    margin-bottom: var(--space-lg);
  }
  
  .integration-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-lg) 0;
  }
  
  .integration-card {
    background-color: var(--color-light);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }
  
  .integration-card h3 {
    margin-top: 0;
    font-size: 1.25rem;
    color: var(--color-secondary);
  }
  
  .integration-note {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid #eee;
    font-style: italic;
  }
  
  /* Product Highlight */
  .product-highlight {
    background-color: var(--color-light);
  }
  
  .product-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-lg);
  }
  
  .product-card {
    background-color: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }
  
  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }
  
  .product-image {
    height: 250px;
    overflow: hidden;
  }
  
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }
  
  .product-card:hover .product-image img {
    transform: scale(1.05);
  }
  
  .product-content {
    padding: var(--space-lg);
  }
  
  .product-content h3 {
    margin-top: 0;
  }
  
  /* Media Queries */
  @media (max-width: 992px) {
    .solution-overview, .use-case {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    
    .use-case.reverse {
      grid-template-columns: 1fr;
      direction: ltr;
    }
    
    .use-case-image {
      height: 300px;
    }
    
    .product-cards {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 768px) {
    .solution-hero h1 {
      font-size: 2.5rem;
    }
    
    .tagline {
      font-size: 1.2rem;
    }
  }
</style>
