---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Security Solutions">
  <div class="solution-hero">
    <div class="container">
      <h1>Security & Defense Solutions</h1>
      <p class="tagline">Advanced aerial surveillance and rapid-response systems to protect your critical assets</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="solution-overview">
        <div class="overview-content">
          <h2>Revolutionizing Security with Intelligent Aerial Systems</h2>
          <p>
            AstroFly Robotics brings a new dimension to security operations with our autonomous drone solutions. By elevating surveillance to the airspace above your facility, we enable comprehensive coverage, rapid response capabilities, and real-time threat detection that traditional security systems cannot match.
          </p>
          <p>
            Our systems integrate seamlessly with your existing security infrastructure, providing an additional layer of protection that monitors from above, detects anomalies using advanced AI, and responds to incidents in seconds rather than minutes.
          </p>
          <p>
            From perimeter security for high-value facilities to event security and emergency response, our drones serve as force multipliers for your security team – expanding capabilities while minimizing risk to personnel.
          </p>
        </div>
        <div class="overview-image">
          <img src="/images/solutions/security-overview.jpg" alt="Drone providing security surveillance" onerror="this.src='/images/placeholder.jpg'">
        </div>
      </div>

      <div class="key-capabilities">
        <h2>Key Security Capabilities</h2>
        <div class="capabilities-grid">
          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </div>
            <h3>Autonomous Perimeter Patrol</h3>
            <p>
              Scheduled or on-demand patrols of facility perimeters and grounds, creating a visible security presence while gathering continuous surveillance data.
            </p>
          </div>

          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 10l5 5 5-5"></path>
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              </svg>
            </div>
            <h3>Rapid Incident Response</h3>
            <p>
              Immediate deployment to alarm triggers or security events, providing real-time video feeds and situational awareness to security teams.
            </p>
          </div>

          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="12" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="12" y1="18" x2="12" y2="22"></line>
                <line x1="9" y1="22" x2="15" y2="22"></line>
              </svg>
            </div>
            <h3>Multi-Sensor Threat Detection</h3>
            <p>
              Combination of visual, thermal, and infrared imaging to detect intrusions, unauthorized activity, or security breaches even in low-light conditions.
            </p>
          </div>

          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3>AI-Powered Analytics</h3>
            <p>
              Machine learning algorithms that distinguish between normal and suspicious activities, reducing false alarms while ensuring genuine threats are identified.
            </p>
          </div>

          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 16.1A5 5 0 0 1 5.9 20M2 12.05A9 9 0 0 1 9.95 20M2 8V6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6"></path>
                <line x1="2" y1="20" x2="2.01" y2="20"></line>
              </svg>
            </div>
            <h3>Secure Communications</h3>
            <p>
              Encrypted data transmission and secure integration with your security operations center, ensuring sensitive surveillance data remains protected.
            </p>
          </div>

          <div class="capability-card">
            <div class="capability-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <h3>Command Center Integration</h3>
            <p>
              Seamless integration with security management systems, providing operators with full drone control and real-time data visualization.
            </p>
          </div>
        </div>
      </div>

      <div class="use-cases">
        <h2>Security Use Cases</h2>
        
        <div class="use-case">
          <div class="use-case-image">
            <img src="/images/solutions/security-perimeter.jpg" alt="Drone monitoring facility perimeter" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="use-case-content">
            <h3>Critical Infrastructure Protection</h3>
            <p>
              Secure power plants, data centers, manufacturing facilities, and other critical infrastructure with comprehensive aerial surveillance. Our drones provide continuous monitoring of large areas that would be impractical to cover with traditional security cameras and sensors.
            </p>
            <ul class="benefits">
              <li>Detect perimeter breaches within seconds</li>
              <li>Monitor remote areas and blind spots</li>
              <li>Create a visible deterrent to potential intruders</li>
              <li>Reduce security personnel exposure to potential threats</li>
            </ul>
          </div>
        </div>
        
        <div class="use-case reverse">
          <div class="use-case-image">
            <img src="/images/solutions/security-event.jpg" alt="Drone providing event security" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="use-case-content">
            <h3>Event & Venue Security</h3>
            <p>
              Enhance security at large events, concerts, and sports venues with aerial monitoring capabilities. Our drones provide real-time crowd analysis, detect unusual activities, and help security teams respond more effectively to incidents.
            </p>
            <ul class="benefits">
              <li>Monitor crowd flow and identify potential bottlenecks</li>
              <li>Detect unauthorized access attempts</li>
              <li>Track persons of interest across large areas</li>
              <li>Provide aerial support during emergency evacuations</li>
            </ul>
          </div>
        </div>
        
        <div class="use-case">
          <div class="use-case-image">
            <img src="/images/solutions/security-emergency.jpg" alt="Drone assisting in emergency response" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="use-case-content">
            <h3>Emergency Response & Law Enforcement</h3>
            <p>
              Support first responders and law enforcement with immediate aerial intelligence during emergencies, from natural disasters to security incidents. Our drones can be rapidly deployed to provide crucial situational awareness before ground units arrive.
            </p>
            <ul class="benefits">
              <li>Assess situations from a safe distance</li>
              <li>Locate missing persons or suspects</li>
              <li>Create accurate mapping of emergency scenes</li>
              <li>Provide aerial illumination and communication support</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="integration">
        <h2>Integration with Your Security Systems</h2>
        <div class="integration-content">
          <p>
            AstroFly Robotics' drone security solutions are designed to complement and enhance your existing security infrastructure, not replace it. Our systems integrate seamlessly with:
          </p>
          
          <div class="integration-grid">
            <div class="integration-card">
              <h3>Video Management Systems</h3>
              <p>Drone video feeds appear alongside your existing CCTV cameras in your security operations center.</p>
            </div>
            
            <div class="integration-card">
              <h3>Access Control Systems</h3>
              <p>Trigger automated drone deployment when unauthorized access attempts are detected.</p>
            </div>
            
            <div class="integration-card">
              <h3>Alarm & Sensor Networks</h3>
              <p>Dispatch drones to investigate when perimeter sensors or alarms are triggered.</p>
            </div>
            
            <div class="integration-card">
              <h3>Security Information & Event Management</h3>
              <p>Incorporate drone-gathered data into your SIEM for comprehensive security analytics.</p>
            </div>
          </div>
          
          <p class="integration-note">
            Our team works closely with your security personnel to ensure a tailored integration that maximizes the effectiveness of your overall security posture. We provide comprehensive training, documentation, and ongoing support to ensure your team can fully leverage our aerial security capabilities.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section product-highlight">
    <div class="container">
      <h2>Featured Security Products</h2>
      <div class="product-cards">
        <div class="product-card">
          <div class="product-image">
            <img src="/images/products/astroguard-x1.jpg" alt="AstroGuard X1 Security Drone" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="product-content">
            <h3>AstroGuard X1</h3>
            <p>Our flagship autonomous security drone with advanced AI, real-time threat detection, and enterprise integration.</p>
            <a href="/products/astroguard-x1" class="button button-secondary">Learn More</a>
          </div>
        </div>
        
        <div class="product-card">
          <div class="product-image">
            <img src="/images/products/astrorescue-r1.jpg" alt="AstroRescue R1 Emergency Response Drone" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="product-content">
            <h3>AstroRescue R1</h3>
            <p>Specialized drone for emergency response with thermal imaging, searchlight capabilities, and rapid deployment features.</p>
            <a href="/products/astrorescue-r1" class="button button-secondary">Learn More</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to Enhance Your Security Capabilities?</h2>
        <p>Contact our security solutions team to discuss how AstroFly Robotics can strengthen your security posture with intelligent aerial systems.</p>
        <div class="cta-buttons">
          <a href="/contact" class="button button-accent">Contact Us</a>
          <a href="/about" class="button button-secondary">Learn About Our Technology</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .solution-hero {
    background: var(--gradient-primary);
    color: white;
    padding: var(--space-xl) 0;
    text-align: center;
  }
  
  .solution-hero h1 {
    color: white;
    font-size: 3rem;
    margin-bottom: var(--space-sm);
  }
  
  .tagline {
    font-size: 1.5rem;
    opacity: 0.9;
    max-width: 800px;
    margin: 0 auto;
  }
  
  /* Solution Overview */
  .solution-overview {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }
  
  .overview-content h2 {
    margin-top: 0;
  }
  
  .overview-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  
  .overview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  /* Capabilities Grid */
  .key-capabilities {
    margin: var(--space-xl) 0;
  }
  
  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }
  
  .capability-card {
    background-color: white;
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal);
  }
  
  .capability-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }
  
  .capability-icon {
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }
  
  /* Use Cases */
  .use-cases {
    margin: var(--space-xl) 0;
  }
  
  .use-case {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
    align-items: center;
  }
  
  .use-case.reverse {
    grid-template-columns: 1fr 1fr;
    direction: rtl;
  }
  
  .use-case.reverse .use-case-content {
    direction: ltr;
  }
  
  .use-case-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  
  .use-case-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .use-case-content h3 {
    margin-top: 0;
    color: var(--color-primary);
  }
  
  .benefits {
    list-style-type: none;
    padding: 0;
    margin-top: var(--space-md);
  }
  
  .benefits li {
    padding-left: var(--space-md);
    position: relative;
    margin-bottom: var(--space-sm);
  }
  
  .benefits li::before {
    content: "✓";
    color: var(--color-success);
    position: absolute;
    left: 0;
    font-weight: bold;
  }
  
  /* Integration */
  .integration {
    margin: var(--space-xl) 0;
    background-color: white;
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-md);
  }
  
  .integration h2 {
    margin-top: 0;
    margin-bottom: var(--space-lg);
  }
  
  .integration-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-lg) 0;
  }
  
  .integration-card {
    background-color: var(--color-light);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }
  
  .integration-card h3 {
    margin-top: 0;
    font-size: 1.25rem;
    color: var(--color-primary);
  }
  
  .integration-note {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid #eee;
    font-style: italic;
  }
  
  /* Product Highlight */
  .product-highlight {
    background-color: var(--color-light);
  }
  
  .product-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-lg);
  }
  
  .product-card {
    background-color: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }
  
  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }
  
  .product-image {
    height: 250px;
    overflow: hidden;
  }
  
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }
  
  .product-card:hover .product-image img {
    transform: scale(1.05);
  }
  
  .product-content {
    padding: var(--space-lg);
  }
  
  .product-content h3 {
    margin-top: 0;
  }
  
  /* Media Queries */
  @media (max-width: 992px) {
    .solution-overview, .use-case {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    
    .use-case.reverse {
      grid-template-columns: 1fr;
      direction: ltr;
    }
    
    .use-case-image {
      height: 300px;
    }
    
    .product-cards {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 768px) {
    .solution-hero h1 {
      font-size: 2.5rem;
    }
    
    .tagline {
      font-size: 1.2rem;
    }
  }
</style>
