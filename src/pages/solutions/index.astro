---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Solutions">
  <div class="solutions-hero">
    <div class="container">
      <h1>Intelligent Aerial Solutions</h1>
      <p class="tagline">Advanced drone technology for security and manufacturing applications</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="solutions-intro">
        <p>
          AstroFly Robotics delivers cutting-edge autonomous drone solutions designed to transform how businesses approach security and industrial automation. Our innovative systems combine advanced AI, precision engineering, and seamless enterprise integration to deliver unmatched capabilities in aerial surveillance, monitoring, and automation.
        </p>
      </div>

      <div class="solutions-grid">
        <!-- Security Solution -->
        <div class="solution-card">
          <div class="solution-image">
            <img src="/images/solutions/security-overview.jpg" alt="Security & Defense Solutions">
          </div>
          <div class="solution-content">
            <h2>Security & Defense</h2>
            <p>
              Transform your security operations with our autonomous drone surveillance systems. Our drones provide comprehensive aerial monitoring, rapid incident response, and AI-powered threat detection to enhance security across facilities of all types and sizes.
            </p>
            <div class="solution-features">
              <div class="feature">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Perimeter Security</span>
              </div>
              <div class="feature">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
                <span>Threat Detection</span>
              </div>
              <div class="feature">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <span>Incident Response</span>
              </div>
            </div>
            <a href="/solutions/security" class="button button-primary">Explore Security Solutions</a>
          </div>
        </div>

        <!-- Manufacturing Solution -->
        <div class="solution-card reverse">
          <div class="solution-image">
            <img src="/images/solutions/manufacturing-overview.jpg" alt="Manufacturing & Industrial Automation">
          </div>
          <div class="solution-content">
            <h2>Manufacturing & Industrial Automation</h2>
            <p>
              Enhance efficiency, quality control, and safety in your manufacturing operations with our industrial drone solutions. From automated inspections to inventory management, our drones provide unprecedented visibility and actionable insights.
            </p>
            <div class="solution-features">
              <div class="feature">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>Quality Control</span>
              </div>
              <div class="feature">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <rect x="7" y="7" width="3" height="9"></rect>
                  <rect x="14" y="7" width="3" height="5"></rect>
                </svg>
                <span>Inventory Management</span>
              </div>
              <div class="feature">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="6" y1="3" x2="6" y2="15"></line>
                  <circle cx="18" cy="6" r="3"></circle>
                  <circle cx="6" cy="18" r="3"></circle>
                  <path d="M18 9a9 9 0 0 1-9 9"></path>
                </svg>
                <span>Predictive Maintenance</span>
              </div>
            </div>
            <a href="/solutions/manufacturing" class="button button-primary">Explore Manufacturing Solutions</a>
          </div>
        </div>
      </div>

      <div class="integration-section">
        <h2>Seamless Enterprise Integration</h2>
        <p>
          All AstroFly solutions are designed to work with your existing systems and software. Our drones and software platforms integrate seamlessly with your security, manufacturing, and business management tools through secure APIs and flexible connectivity options.
        </p>
        
        <div class="integration-grid">
          <div class="integration-card">
            <div class="integration-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <h3>Control Systems</h3>
            <p>
              Our central control dashboard works with your existing security operations center and manufacturing control systems.
            </p>
          </div>
          
          <div class="integration-card">
            <div class="integration-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
            </div>
            <h3>API Connectivity</h3>
            <p>
              Secure RESTful APIs and WebSocket streams for real-time data exchange with your enterprise systems.
            </p>
          </div>
          
          <div class="integration-card">
            <div class="integration-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </div>
            <h3>Data Analytics</h3>
            <p>
              Integration with business intelligence platforms and data warehouses for comprehensive analysis.
            </p>
          </div>
          
          <div class="integration-card">
            <div class="integration-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 11a9 9 0 0 1 9 9"></path>
                <path d="M4 4a16 16 0 0 1 16 16"></path>
                <circle cx="5" cy="19" r="1"></circle>
              </svg>
            </div>
            <h3>Alerting & Notification</h3>
            <p>
              Connect with your existing alerting systems, mobile apps, and communication tools.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to Transform Your Operations?</h2>
        <p>Contact our solutions team to discuss how AstroFly Robotics can enhance your business with intelligent aerial systems.</p>
        <div class="cta-buttons">
          <a href="/contact" class="button button-accent">Contact Us</a>
          <a href="/products" class="button button-secondary">Explore Products</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .solutions-hero {
    background: var(--gradient-primary);
    color: white;
    padding: var(--space-xl) 0;
    text-align: center;
  }
  
  .solutions-hero h1 {
    color: white;
    font-size: 3rem;
    margin-bottom: var(--space-sm);
  }
  
  .tagline {
    font-size: 1.5rem;
    opacity: 0.9;
    max-width: 800px;
    margin: 0 auto;
  }
  
  /* Solutions Introduction */
  .solutions-intro {
    max-width: 900px;
    margin: 0 auto var(--space-xl);
    text-align: center;
    font-size: 1.2rem;
  }
  
  /* Solutions Grid */
  .solutions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }
  
  .solution-card {
    background-color: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    display: grid;
    grid-template-columns: 1fr 1fr;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }
  
  .solution-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }
  
  .solution-card.reverse {
    direction: rtl;
  }
  
  .solution-card.reverse .solution-content {
    direction: ltr;
  }
  
  .solution-image {
    height: 100%;
    overflow: hidden;
  }
  
  .solution-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }
  
  .solution-card:hover .solution-image img {
    transform: scale(1.05);
  }
  
  .solution-content {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
  }
  
  .solution-content h2 {
    font-size: 1.8rem;
    margin-bottom: var(--space-md);
    color: var(--color-primary);
  }
  
  .solution-content p {
    margin-bottom: var(--space-lg);
    flex-grow: 1;
  }
  
  .solution-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }
  
  .feature {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  
  .feature svg {
    color: var(--color-primary);
  }
  
  .feature span {
    font-weight: 500;
  }
  
  /* Integration Section */
  .integration-section {
    margin-top: var(--space-xl);
    background-color: var(--color-light);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    text-align: center;
  }
  
  .integration-section h2 {
    margin-bottom: var(--space-sm);
  }
  
  .integration-section > p {
    max-width: 900px;
    margin: 0 auto var(--space-xl);
  }
  
  .integration-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-lg);
  }
  
  .integration-card {
    background-color: white;
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal);
  }
  
  .integration-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }
  
  .integration-icon {
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }
  
  .integration-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
  }
  
  .integration-card p {
    font-size: 0.95rem;
  }
  
  /* Media Queries */
  @media (max-width: 992px) {
    .solution-card,
    .solution-card.reverse {
      grid-template-columns: 1fr;
      direction: ltr;
    }
    
    .solution-image {
      height: 300px;
    }
  }
  
  @media (max-width: 768px) {
    .solutions-hero h1 {
      font-size: 2.5rem;
    }
    
    .tagline {
      font-size: 1.2rem;
    }
    
    .solutions-intro {
      font-size: 1.1rem;
    }
  }
</style>
