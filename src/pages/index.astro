---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Home">
  <!-- Hero Section with drone video -->
  <section class="hero">
    <video class="hero-video" autoplay loop muted playsinline>
      <source src="/videos/hero-video.mp4" type="video/mp4">
    </video>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <h1>Intelligent Aerial Security & Automation for the Future</h1>
      <p>
        AstroFly Robotics is a cutting-edge drone technology company specializing in AI-powered security and manufacturing automation. Our autonomous aerial systems provide real-time surveillance, rapid response, and precision-driven industrial monitoring.
      </p>
      <div class="hero-buttons">
        <a href="/solutions/security" class="button button-primary">Security Solutions</a>
        <a href="/solutions/manufacturing" class="button button-secondary">Manufacturing Solutions</a>
      </div>
    </div>
  </section>

  <!-- Products Showcase Section -->
  <section class="section">
    <div class="container">
      <h2 class="text-center">Our Advanced Drone Solutions</h2>
      <p class="text-center subtitle">Cutting-edge autonomous systems for security and industrial applications</p>
      
      <div class="product-grid">
        <!-- AstroGuard X1 -->
        <div class="product-card">
          <div class="product-image">
            <img src="/images/products/astroguard-x1.jpg" alt="AstroGuard X1 Security Drone" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="product-content">
            <h3>AstroGuard X1</h3>
            <p>Our flagship autonomous security drone with advanced AI, real-time threat detection, and seamless integration capabilities.</p>
            <a href="/products/astroguard-x1" class="button button-secondary">Learn More</a>
          </div>
        </div>

        <!-- AstroCargo D3 -->
        <div class="product-card">
          <div class="product-image">
            <img src="/images/products/astrocargo-d3.jpg" alt="AstroCargo D3 Delivery Drone" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="product-content">
            <h3>AstroCargo D3</h3>
            <p>Revolutionize aerial logistics with our autonomous delivery drone featuring robust payload handling and precision navigation.</p>
            <a href="/products/astrocargo-d3" class="button button-secondary">Learn More</a>
          </div>
        </div>

        <!-- AstroInspect Z2 -->
        <div class="product-card">
          <div class="product-image">
            <img src="/images/products/astroinspect-z2.jpg" alt="AstroInspect Z2 Industrial Inspection Drone" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="product-content">
            <h3>AstroInspect Z2</h3>
            <p>High-precision industrial inspection drone with ultra-high resolution imaging and advanced sensor technologies.</p>
            <a href="/products/astroinspect-z2" class="button button-secondary">Learn More</a>
          </div>
        </div>

        <!-- AstroRescue R1 -->
        <div class="product-card">
          <div class="product-image">
            <img src="/images/products/astrorescue-r1.jpg" alt="AstroRescue R1 Emergency Response Drone" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="product-content">
            <h3>AstroRescue R1</h3>
            <p>Rapid aerial support for emergencies and disaster scenarios, providing critical situational awareness to first responders.</p>
            <a href="/products/astrorescue-r1" class="button button-secondary">Learn More</a>
          </div>
        </div>

        <!-- AstroSurvey Q1 -->
        <div class="product-card">
          <div class="product-image">
            <img src="/images/products/astrosurvey-q1.jpg" alt="AstroSurvey Q1 Geospatial Mapping Drone" onerror="this.src='/images/placeholder.jpg'">
          </div>
          <div class="product-content">
            <h3>AstroSurvey Q1</h3>
            <p>High-precision aerial mapping and surveying for urban planning, agriculture, and environmental monitoring.</p>
            <a href="/products/astrosurvey-q1" class="button button-secondary">Learn More</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Capabilities Section -->
  <section class="section section-dark">
    <div class="container">
      <h2 class="text-center">Core Capabilities</h2>
      <div class="capabilities-grid">
        <div class="capability-card">
          <div class="capability-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>Security & Defense</h3>
          <p>Autonomous patrol drones for real-time threat detection and rapid incident response. Protect your facilities with advanced AI-powered surveillance.</p>
        </div>
        
        <div class="capability-card">
          <div class="capability-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
          </div>
          <h3>Manufacturing & Automation</h3>
          <p>Automated inspections, quality control, and operational monitoring to streamline production and reduce downtime through constant aerial oversight.</p>
        </div>
        
        <div class="capability-card">
          <div class="capability-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h3>Logistics & Infrastructure</h3>
          <p>Warehousing surveillance, efficient distribution networks, and continuous monitoring of critical infrastructure through intelligent aerial systems.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call To Action Section -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to Transform Your Operations?</h2>
        <p>Discover how AstroFly Robotics can enhance your security and manufacturing capabilities with our advanced drone solutions.</p>
        <div class="cta-buttons">
          <a href="/contact" class="button button-accent">Contact Us</a>
          <a href="/about" class="button button-secondary">Learn About Us</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .text-center {
    text-align: center;
  }
  
  .subtitle {
    font-size: 1.2rem;
    margin-bottom: var(--space-xl);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  
  /* Product Grid */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }
  
  .product-card {
    background-color: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }
  
  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }
  
  .product-image {
    height: 200px;
    overflow: hidden;
  }
  
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }
  
  .product-card:hover .product-image img {
    transform: scale(1.05);
  }
  
  .product-content {
    padding: var(--space-lg);
  }
  
  .product-content h3 {
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }
  
  .product-content p {
    margin-bottom: var(--space-md);
  }
  
  /* Capabilities Grid */
  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }
  
  .capability-card {
    text-align: center;
    padding: var(--space-lg);
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-lg);
    transition: transform var(--transition-normal);
  }
  
  .capability-card:hover {
    transform: translateY(-5px);
  }
  
  .capability-icon {
    margin: 0 auto var(--space-md);
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: var(--color-secondary);
  }
  
  .capability-card h3 {
    color: white;
    margin-bottom: var(--space-md);
  }
  
  /* CTA Section */
  .cta-section {
    background: var(--gradient-primary);
    color: white;
  }
  
  .cta-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .cta-content h2 {
    color: white;
  }
  
  .cta-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    margin-top: var(--space-lg);
  }
  
  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
    
    .capabilities-grid {
      grid-template-columns: 1fr;
    }
    
    .cta-buttons {
      flex-direction: column;
    }
  }
</style>
